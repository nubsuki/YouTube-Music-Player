{
  "name": "aurplayer",
  "version": "3.1.0",
  "description": "AurPlayer - Desktop player for YouTube Music",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nubsuki/AurPlayer"
  },
  "scripts": {
    "start": "electron .",
    "build:all": "electron-builder --linux --win --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "aur",
    "aurplayer",
    "youtube",
    "music",
    "player",
    "electron",
    "desktop",
    "audio",
    "streaming",
    "youtube-music",
    "music-player",
    "media-player"
  ],
  "author": {
    "name": "nubsuki",
    "email": "nubsuki@proton.me"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nubsuki.aurplayer",
    "productName": "AurPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "node_modules/**/*"
    ],
    "protocols": [
      {
        "name": "AurPlayer",
        "schemes": [
          "aurplayer",
          "ytmp"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "nubsuki",
      "repo": "AurPlayer"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AurPlayer",
      "artifactName": "AurPlayer-Setup-${version}.${ext}"
    },
    "linux": {
      "maintainer": "nubsuki <nubsuki@proton.me>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Audio",
      "artifactName": "AurPlayer-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "artifactName": "AurPlayer-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@gorhill/ubo-core": "^0.1.30",
    "@xhayper/discord-rpc": "^1.5.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "node-fetch": "^3.3.2",
    "socket.io-client": "^4.8.4"
  }
}